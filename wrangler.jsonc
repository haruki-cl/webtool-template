{
  "name": "tool-app",
  "main": "backend/src/index.ts",
  // .npmrc の min-release-age で入る Wrangler は 1 週間ほど前の版なので、日付もそれより前にする
  "compatibility_date": "2026-10-13",
  // 試しでは workers.dev で見る。本番ではカスタムドメインを使い、ここを false にする
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tool-app-db",
      // Deploy to Cloudflare が、新しく作った D1 の ID に書き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "backend/migrations"
    }
  ]
}
